[Service]
Type=simple
WorkingDirectory=/mnt/storage/Dev/Workspace/Python/Codex Remote
ExecStart="/mnt/storage/Dev/Workspace/Python/Codex Remote/venv/bin/python" bot_worker.py
EnvironmentFile="/mnt/storage/Dev/Workspace/Python/Codex Remote/.env"
