# Copy this file to .env and fill it with your own values.

# Bot token received from @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Your Telegram user_id (and, if desired, the ID of other trusted admins separated by commas)
# You can find out your ID, for example, through the bot @userinfobot
ALLOWED_ADMIN_IDS=123456789

# The directory from which the session starts (by default, the home folder)
INITIAL_CWD=/home/youruser/projects

# The Codex CLI launch command (if it is not in the PATH— specify the full path)
CODEX_COMMAND=codex

# Shell for the /sh command
SHELL_COMMAND=/bin/bash

# Once every how many seconds is a message with accumulated PTY output edited
OUTPUT_FLUSH_INTERVAL=1.7

# Maximum length of one output block in a Telegram message
MAX_MESSAGE_LENGTH=3500

LOG_LEVEL=INFO
